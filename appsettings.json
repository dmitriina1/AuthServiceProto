{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=authservice;Username=authservice"
  },
  "AuthServer": {
    "Issuer": "https://localhost:7036/",
    "AccessTokenMinutes": 5,
    "RefreshTokenDays": 14
  },
  "Identity": {
    "PasswordRequiredLength": 8,
    "LockoutMinutes": 15,
    "MaxFailedAccessAttempts": 5
  },
  "ExternalProviders": {
    "Yandex": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "OpenIddictProvisioning": {
    "Scopes": [],
    "Clients": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
